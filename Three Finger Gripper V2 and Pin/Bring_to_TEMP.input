
units metal
atom_style molecular
boundary s s s    #non-periodic

# System definition
read_data 2_gripper_pin_pickup.data

# set groups
group free type 1 2
group pinanchor type  3 4
group posy type  5 6
group center type  7 8

# Pair Coefficients
pair_style	airebo 3.0 1 0
pair_coeff * * CH.airebo C H C H C H C H

#freeze the jig atoms atoms
fix anchorfix pinanchor setforce 0.0 0.0 0.0 #first is ID = user-assigned name for the fix,  ID of the group of atoms
velocity pinanchor set 0.0 0.0 0.0

fix pinfix posy setforce 0.0 0.0 0.0 #first is ID = user-assigned name for the fix,  ID of the group of atoms
velocity posy set 0.0 0.0 0.0

fix centerfix center setforce 0.0 0.0 0.0 #first is ID = user-assigned name for the fix,  ID of the group of atoms
velocity center set 0.0 0.0 0.0


#Minimize before bringing to temperature

minimize 1.0e-4 1.0e-6 1000 10000

# Equilibrate to 90K
fix nve all nve
timestep 0.00025

# bring the temp of all free atoms to 90K
fix freefix free temp/berendsen 90. 90. 0.25

#output
#dump mounted_wheel_dump all atom 100 bring_to_temp_ping.lammpstrj
thermo 100 #print thermo data to the terminal every 100 steps
run 4000 #4000
write_restart 2_TEMP_pin_pickup.init.restart
