
units metal
atom_style molecular
boundary p p p  

# System definition
read_restart 1in2out.init.restart

# set groups
group free type 1 2
group anchor type  3 4
group rotz type  5 6

# Pair Coefficients
pair_style	airebo 3.0 1 0
pair_coeff * * CH.airebo C H C H C H

fix anchorfix anchor setforce 0.0 0.0 0.0 #first is ID = user-assigned name for the fix,  ID of the group of atoms
velocity anchor set 0.0 0.0 0.0

#add the MD part
fix nve all nve
timestep 0.00025 #picoseconds/step = 1E-12 seconds

# bring the temp of all the  atoms except the top and bottom group to 300
fix thermo_free free temp/berendsen 300. 300. 0.25

#rotate around z
fix rotate_fix rotz move rotate 0.18 -1.492 18.47 0.0 0.0 1.0 250

#VMD IMD connection. The VMd command is imd conenct localhost 5678
#fix comm all imd 5678 unwrap off fscale 100.0 trate 10 nowait off

#output
dump gear_beam all atom 1000 1in2out4GHz.lammpstrj

thermo 5000
run 1000000 #1000 pico seconds, 1 nanosecond, 4GHz frequency

#write_restart ddd.restart

