
units metal
atom_style molecular
boundary p p p    #periodic

# System definition
read_data Clutch_simB_4rot.data

# set groups
group free type 1 2
group anchor type  3 4
group transrotz type  5 6


# Pair Coefficients
pair_style	airebo 3.0 1 0
pair_coeff * * CH.airebo C H C H C H

#add the MD part
fix nve all nve
timestep 0.00025 #picoseconds/step = 1E-12 seconds

# bring the temp of all the  atoms except the top and bottom group to 300
fix thermo_free free temp/berendsen 90.0 90.0 0.25

fix carfix anchor setforce 0.0 0.0 0.0 #first is ID = user-assigned name for the fix,  ID of the group of atoms
velocity anchor set 0.0 0.0 0.0

#rotate around z
fix rotate_fix2 transrotz move rotate 0.598 15.998 312.531  0 0 1 125

#VMD IMD connection. The VMd command is imd conenct localhost 5678
#fix comm all imd 5678 unwrap off fscale 100.0 trate 10 nowait off

#output
dump gear_beam all atom 500 3_clutch_rotating.lammpstrj

thermo 5000
run 60000 #1000 pico seconds, 1 nanosecond, 4GHz frequency

write_restart 3_cluch_rotating.restart

