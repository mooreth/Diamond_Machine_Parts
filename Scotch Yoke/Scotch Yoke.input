
units metal
atom_style molecular
boundary s s s    #non-periodic

# System definition
read_restart yoke_4sim.init.restart

# set groups
group free type 1 2
group anchor type  3 4
group moveme type   5 6

# Pair Coefficients
pair_style	airebo 3.0 1 0
pair_coeff * * CH.airebo C H C H C H 

#freeze anchor atoms 
fix freeze_anchor anchor setforce 0.0 0.0 0.0 #first is ID = user-assigned name for the fix,  ID of the group of atoms
velocity anchor set 0.0 0.0 0.0

#add the MD part to come to temp
fix nve all nve
timestep 0.00025 #picoseconds/step = 1E-12 seconds

# run at 90LK
fix thermo_free free temp/berendsen 90. 90. 0.25

#Rotate around x either way
fix rotate_fix moveme move rotate -7.685 73.605 -4.8 1.0 0.0 0.0 500 #this is still 4 GHz

#output
dump temp_dump all custom 10000 yoke_one_spin.lammpstrj id type x y z
thermo 2500
run 2000000 


