
units metal
atom_style molecular
boundary s s s    #non-periodic

# System definition
read_restart Energy_min_multiplex.init.restart

# set groups
group free type 1 2
group in type  3 4
group out type   5 6


# Pair Coefficients
pair_style	airebo 3.0 1 0
pair_coeff * * CH.airebo C H C H C H 

#freeze the motor atoms 

fix infix in setforce 0.0 0.0 0.0 #first is ID = user-assigned name for the fix,  ID of the group of atoms
velocity in set 0.0 0.0 0.0

fix outfix out setforce 0.0 0.0 0.0 #first is ID = user-assigned name for the fix,  ID of the group of atoms
velocity out set 0.0 0.0 0.0

#add the MD part to come to temp
fix nve all nve
timestep 0.00025 #picoseconds/step = 1E-12 seconds

# bring the temp of all the  atoms except the motor atoms to 90K slowly
fix thermo_free free temp/berendsen 0. 90. 0.25

#output
#dump 3DOF_temp_dump all custom 100 3DOF_temp.lammpstrj id type x y z vx vy vz
thermo 10
run 6000 
write_restart multiplex_at_temp.init.restart


