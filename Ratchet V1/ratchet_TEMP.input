

units metal
atom_style molecular
boundary s s s    #non-periodic

# System definition
read_data ratchet_1.data

# set groups
group free type 1 2
group anchor type 3 4
group rotz type 5 6


# Pair Coefficients
pair_style	airebo 3.0 1 0
pair_coeff * * CH.airebo C H C H C H


#freeze the cantilever anchor atoms
fix anchor_fix anchor setforce 0.0 0.0 0.0 #first is ID = user-assigned name for the fix,  ID of the group of atoms
velocity anchor set 0.0 0.0 0.0

fix rotz_fix rotz setforce 0.0 0.0 0.0 #first is ID = user-assigned name for the fix,  ID of the group of atoms
velocity rotz set 0.0 0.0 0.0


#Minimize before bringing to temperature

minimize 1.0e-4 1.0e-6 1000 10000

# Equilibrate to 300K
fix nve all nve
timestep 0.00025
# bring the temp of all the atoms except the anchor atoms to 300
fix free_fix free temp/berendsen 300. 300. 0.25


#dump mydmp all atom 500 dump.lammpstrj
thermo 100 #print thermo data to the terminal every 100 steps
run 6000 
write_restart ratchet1_4SIM.init.restart 

